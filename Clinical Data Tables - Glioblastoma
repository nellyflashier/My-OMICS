###############################################################################
#PART 2: NORMALIZE COUNT DATA USING DESeq2 AND ASSSESING DATA FURTHER 
###############################################################################

#load counts file
counts = read.table("counts.csv",header=TRUE,row.names = 1,sep='\t')

#Load library
library(DESeq2)

#remove rows with a mean of =>1 read
counts = subset(counts, apply(counts, 1, mean) >= 1)

#Prepare DESeq2 input data 
#Convert DF into a matrix
counts = as.matrix(counts)

#sample_group column a factor
ss$group = factor(ss$group)

#Run DESeq2
dds = DESeqDataSetFromMatrix(countData = counts,colData = ss, design = ~group)
dds = DESeq(dds)

#Extract normalized counts  and truncate to 2dp
em = as.data.frame(counts(dds, normalized=TRUE))
em = round(em,2)

#Saves the em table to working directory 
em_out = cbind(row.names(em), em)
names(em_out)[1] = "ID"
write.table(em_out, file="EM.csv",row.names=FALSE, sep="\t", quote = FALSE)

